<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      🧪 Internal-seam reuse spike (see docs/spikes/internal-seam-reuse.md).

      This project deliberately compiles against Aspire.Hosting.Azure's INTERNAL types. Aspire grants
      InternalsVisibleTo("Aspire.Hosting.Azure.Tests, PublicKey=...aspire OSS key...), and CoreCLR does not
      validate strong-name signatures — so an assembly that (a) is named Aspire.Hosting.Azure.Tests and
      (b) is public-signed with just the public half of Aspire's OSS key (aspire-public.snk, the exact key
      blob from the IVT attribute) gets full compile-time access to the internals. No upstream ask, no
      reflection, no IL emit.
    -->
    <AssemblyName>Aspire.Hosting.Azure.Tests</AssemblyName>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>aspire-public.snk</AssemblyOriginatorKeyFile>
    <NoWarn>$(NoWarn);ASPIREPIPELINES001;ASPIREPIPELINES002;ASPIREPIPELINES003;ASPIREPIPELINES004;ASPIRECOMPUTE001;ASPIRECOMPUTE002;ASPIRECOMPUTE003;ASPIREAZURE001;ASPIREPUBLISHERS001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
